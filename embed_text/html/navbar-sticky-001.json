  "title": "顶部粘性导航栏(汉堡菜单 + 下拉子菜单 + 滚动变色)",
  "embedText": "顶部导航栏 navbar header 粘性导航 置顶 sticky 汉堡菜单 hamburger 移动端响应式 滚动变色 透明 下拉子菜单 dropdown logo",
  "description": "landing 页顶部导航栏,桌面端横向排列、移动端汉堡菜单折叠,初始透明、滚动超 50px 变白加阴影,含下拉子菜单",
  "files": [{"path": "index.html", "content": "<nav id=\"nav\" class=\"nav\"><a class=\"logo\" href=\"#\">✦ Brand</a><ul id=\"menu\" class=\"menu\"><li><a href=\"#\">首页</a></li><li class=\"sub\"><a href=\"#\">产品 ▾</a><ul class=\"drop\"><li><a href=\"#\">功能</a></li><li><a href=\"#\">定价</a></li><li><a href=\"#\">更新</a></li></ul></li><li><a href=\"#\">文档</a></li><li><a href=\"#\">关于</a></li></ul><a class=\"cta\" href=\"#\">开始使用</a><button id=\"burger\" class=\"burger\">☰</button></nav><main><section class=\"hero\"><h1>向下滚动查看导航变色效果</h1></section><section class=\"spacer\">(这里是你的页面内容)</section></main><script>const nav=document.getElementById('nav');const menu=document.getElementById('menu');document.getElementById('burger').addEventListener('click',()=>menu.classList.toggle('open'));window.addEventListener('scroll',()=>nav.classList.toggle('scrolled',window.scrollY>50));</script><style>*{box-sizing:border-box;margin:0;padding:0;font-family:system-ui,sans-serif}body{color:#0f172a}.nav{position:fixed;inset:0 0 auto 0;display:flex;align-items:center;gap:24px;padding:16px 32px;background:transparent;transition:.2s;z-index:100}.nav.scrolled{background:#fff;box-shadow:0 2px 12px rgba(0,0,0,.06)}.logo{font-weight:700;color:#0f172a;text-decoration:none;font-size:18px}.menu{list-style:none;display:flex;gap:24px;flex:1}.menu a{color:#334155;text-decoration:none;font-size:15px}.menu a:hover{color:#6366f1}.sub{position:relative}.drop{position:absolute;top:100%;left:0;background:#fff;box-shadow:0 8px 24px rgba(0,0,0,.1);border-radius:8px;padding:8px 0;min-width:160px;list-style:none;display:none}.drop li{padding:8px 16px}.sub:hover .drop{display:block}.cta{background:#6366f1;color:#fff;padding:8px 18px;border-radius:999px;text-decoration:none;font-weight:500}.burger{display:none;background:none;border:none;font-size:24px;cursor:pointer}.hero{min-height:100vh;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#6366f1,#ec4899);color:#fff;text-align:center}.hero h1{font-size:clamp(1.5rem,4vw,3rem)}.spacer{padding:80px 32px;background:#f8fafc;min-height:600px;text-align:center;color:#64748b}@media(max-width:720px){.menu{display:none;position:absolute;top:100%;left:0;right:0;flex-direction:column;background:#fff;padding:16px;gap:12px}.menu.open{display:flex}.burger{display:block}.drop{position:static;box-shadow:none;padding-left:16px}}</style>"}],
  "qualityScore": 0.92
}
