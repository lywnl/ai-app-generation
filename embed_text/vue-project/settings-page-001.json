{
  "id": "vue-settings-page-001",
  "type": "vue-project",
  "category": "dashboard",
  "style": ["minimal"],
  "tech": ["vue3", "composition-api", "element-plus"],
  "title": "Vue3 设置页(侧边二级导航 + 右侧表单)",
  "embedText": "Vue3 设置页 settings 偏好 基本设置 账号设置 通知设置 安全设置 密码修改 侧边导航 tab 切换 个人设置",
  "description": "后台系统的设置页布局,左侧二级菜单(基本资料/账号安全/通知偏好/数据导出),右侧对应内容区展示相关表单",
  "files": [{"path": "src/views/Settings.vue", "content": "<template>\n  <div class=\"page\">\n    <el-row :gutter=\"24\">\n      <el-col :xs=\"24\" :md=\"6\">\n        <el-menu :default-active=\"active\" @select=\"k => active = k\" class=\"side\">\n          <el-menu-item index=\"basic\"><el-icon><User /></el-icon>基本资料</el-menu-item>\n          <el-menu-item index=\"security\"><el-icon><Lock /></el-icon>账号安全</el-menu-item>\n          <el-menu-item index=\"notify\"><el-icon><Bell /></el-icon>通知偏好</el-menu-item>\n          <el-menu-item index=\"export\"><el-icon><Download /></el-icon>数据导出</el-menu-item>\n        </el-menu>\n      </el-col>\n      <el-col :xs=\"24\" :md=\"18\">\n        <div class=\"panel\" v-if=\"active === 'basic'\">\n          <h3>基本资料</h3>\n          <el-form label-position=\"top\" style=\"max-width:480px\">\n            <el-form-item label=\"昵称\"><el-input v-model=\"form.nickname\" /></el-form-item>\n            <el-form-item label=\"邮箱\"><el-input v-model=\"form.email\" /></el-form-item>\n            <el-form-item label=\"个人简介\"><el-input v-model=\"form.bio\" type=\"textarea\" :rows=\"3\" /></el-form-item>\n            <el-button type=\"primary\" @click=\"save\">保存修改</el-button>\n          </el-form>\n        </div>\n        <div class=\"panel\" v-if=\"active === 'security'\">\n          <h3>修改密码</h3>\n          <el-form label-position=\"top\" style=\"max-width:480px\">\n            <el-form-item label=\"当前密码\"><el-input type=\"password\" show-password /></el-form-item>\n            <el-form-item label=\"新密码\"><el-input type=\"password\" show-password /></el-form-item>\n            <el-form-item label=\"确认新密码\"><el-input type=\"password\" show-password /></el-form-item>\n            <el-button type=\"primary\" @click=\"save\">更新密码</el-button>\n          </el-form>\n        </div>\n        <div class=\"panel\" v-if=\"active === 'notify'\">\n          <h3>通知偏好</h3>\n          <div class=\"row\" v-for=\"n in notify\" :key=\"n.k\"><span>{{ n.label }}</span><el-switch v-model=\"n.v\" /></div>\n        </div>\n        <div class=\"panel\" v-if=\"active === 'export'\">\n          <h3>数据导出</h3>\n          <p class=\"muted\">可导出过去 12 个月的全部个人数据(JSON 格式)</p>\n          <el-button type=\"primary\" @click=\"save\">请求数据导出</el-button>\n        </div>\n      </el-col>\n    </el-row>\n  </div>\n</template>\n\n<script setup>\nimport { ref, reactive } from 'vue'\nimport { ElMessage } from 'element-plus'\nconst active = ref('basic')\nconst form = reactive({ nickname: '小明', email: 'xm@example.com', bio: '一个热爱代码的前端开发者' })\nconst notify = ref([\n  { k: 'mail', label: '邮件通知', v: true },\n  { k: 'sms', label: '短信通知', v: false },\n  { k: 'push', label: '应用内推送', v: true }\n])\nfunction save() { ElMessage.success('已保存') }\n</script>\n\n<style scoped>\n.page { padding: 24px; }\n.side { border-radius: 12px; padding: 8px 0; }\n.panel { background: #fff; border-radius: 12px; padding: 28px; min-height: 400px; }\n.panel h3 { margin-bottom: 20px; color: #0f172a; }\n.row { display: flex; justify-content: space-between; align-items: center; padding: 14px 0; border-bottom: 1px solid #f1f5f9; }\n.muted { color: #64748b; margin-bottom: 16px; }\n</style>"}],
  "qualityScore": 0.91
}
