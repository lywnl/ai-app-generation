  "title": "Vue3 + Element Plus 注册表单(邮箱/密码/确认密码/协议 + 完整校验)",
  "embedText": "Vue3 注册表单 注册页 sign up 邮箱 密码 确认密码 密码强度 协议勾选 同意条款 验证码 表单校验 异步校验 el-form",
  "description": "标准注册页,包含邮箱、密码、确认密码、协议勾选四个字段,密码强度校验、确认密码一致性校验、未勾协议禁用提交",
  "files": [
    {
      "path": "src/views/Register.vue",
      "content": "<template>\n  <div class=\"wrap\">\n    <el-card class=\"card\" shadow=\"hover\">\n      <h2>创建账号</h2>\n      <el-form ref=\"formRef\" :model=\"form\" :rules=\"rules\" label-position=\"top\">\n        <el-form-item label=\"邮箱\" prop=\"email\">\n          <el-input v-model=\"form.email\" placeholder=\"you@example.com\" />\n        </el-form-item>\n        <el-form-item label=\"密码\" prop=\"password\">\n          <el-input v-model=\"form.password\" type=\"password\" show-password placeholder=\"至少 8 位,含字母与数字\" />\n        </el-form-item>\n        <el-form-item label=\"确认密码\" prop=\"confirm\">\n          <el-input v-model=\"form.confirm\" type=\"password\" show-password />\n        </el-form-item>\n        <el-form-item prop=\"agree\">\n          <el-checkbox v-model=\"form.agree\">我已阅读并同意 <el-link type=\"primary\" :underline=\"false\">服务条款</el-link> 与 <el-link type=\"primary\" :underline=\"false\">隐私政策</el-link></el-checkbox>\n        </el-form-item>\n        <el-button type=\"primary\" :loading=\"loading\" :disabled=\"!form.agree\" style=\"width:100%\" @click=\"submit\">注册</el-button>\n        <div class=\"foot\">已有账号?<router-link to=\"/login\">登录</router-link></div>\n      </el-form>\n    </el-card>\n  </div>\n</template>\n\n<script setup>\nimport { reactive, ref } from 'vue'\nimport { ElMessage } from 'element-plus'\nconst formRef = ref()\nconst loading = ref(false)\nconst form = reactive({ email: '', password: '', confirm: '', agree: false })\nconst rules = {\n  email: [\n    { required: true, message: '请输入邮箱', trigger: 'blur' },\n    { type: 'email', message: '邮箱格式不正确', trigger: 'blur' }\n  ],\n  password: [\n    { required: true, message: '请输入密码', trigger: 'blur' },\n    { min: 8, message: '密码至少 8 位', trigger: 'blur' },\n    { pattern: /(?=.*[a-zA-Z])(?=.*\\d)/, message: '密码需包含字母和数字', trigger: 'blur' }\n  ],\n  confirm: [\n    { required: true, message: '请再次输入密码', trigger: 'blur' },\n    { validator: (r, v, cb) => v === form.password ? cb() : cb(new Error('两次密码不一致')), trigger: 'blur' }\n  ],\n  agree: [\n    { validator: (r, v, cb) => v ? cb() : cb(new Error('请先同意协议')), trigger: 'change' }\n  ]\n}\nasync function submit() {\n  await formRef.value.validate()\n  loading.value = true\n  setTimeout(() => { loading.value = false; ElMessage.success('注册成功,请登录') }, 800)\n}\n</script>\n\n<style scoped>\n.wrap { min-height: 100vh; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #6366f1, #ec4899); padding: 16px; }\n.card { width: 100%; max-width: 440px; border-radius: 16px; }\nh2 { text-align: center; margin: 0 0 24px; color: #0f172a; }\n.foot { text-align: center; margin-top: 16px; color: #64748b; font-size: 14px; }\n.foot a { color: #6366f1; text-decoration: none; margin-left: 4px; }\n</style>"
    }
  ],
