  "title": "Vue3 订单详情页(订单信息 + 商品清单 + 收货地址 + 支付信息 + 操作)",
  "embedText": "Vue3 订单详情 订单页 订单信息 商品清单 收货地址 支付方式 物流信息 再次购买 申请售后 订单状态 电商 发票",
  "description": "电商订单详情页,顶部订单号与状态徽章、中间四栏卡片(商品列表/收货地址/支付信息/物流),右下角操作按钮",
  "files": [
    {
      "path": "src/views/OrderDetail.vue",
      "content": "<template>\n  <div class=\"page\">\n    <div class=\"head\">\n      <div>\n        <h2>订单详情</h2>\n        <div class=\"no\">订单号:{{ order.no }}</div>\n      </div>\n      <el-tag type=\"success\" size=\"large\">{{ order.status }}</el-tag>\n    </div>\n    <el-card class=\"panel\">\n      <h3>商品清单</h3>\n      <div class=\"item\" v-for=\"p in order.items\" :key=\"p.id\">\n        <img :src=\"p.img\" :alt=\"p.name\">\n        <div class=\"info\">\n          <div class=\"name\">{{ p.name }}</div>\n          <div class=\"sku\">{{ p.spec }}</div>\n        </div>\n        <div class=\"qty\">×{{ p.qty }}</div>\n        <div class=\"sub\">¥{{ (p.price * p.qty).toFixed(2) }}</div>\n      </div>\n      <div class=\"total\">\n        <div class=\"row\"><span>商品总计</span><span>¥{{ goodsTotal.toFixed(2) }}</span></div>\n        <div class=\"row\"><span>运费</span><span>¥{{ order.shipping.toFixed(2) }}</span></div>\n        <div class=\"row\"><span>优惠</span><span class=\"dis\">-¥{{ order.discount.toFixed(2) }}</span></div>\n        <div class=\"row final\"><span>实付</span><span class=\"pay\">¥{{ finalTotal.toFixed(2) }}</span></div>\n      </div>\n    </el-card>\n    <div class=\"two\">\n      <el-card class=\"panel\">\n        <h3>收货地址</h3>\n        <div class=\"addr\">\n          <div class=\"n\">{{ order.addr.name }} · {{ order.addr.phone }}</div>\n          <div class=\"d\">{{ order.addr.detail }}</div>\n        </div>\n      </el-card>\n      <el-card class=\"panel\">\n        <h3>支付信息</h3>\n        <div class=\"pay-info\">\n          <div><span>支付方式</span><strong>{{ order.payment.method }}</strong></div>\n          <div><span>支付时间</span><strong>{{ order.payment.time }}</strong></div>\n          <div><span>交易号</span><strong>{{ order.payment.tx }}</strong></div>\n        </div>\n      </el-card>\n    </div>\n    <div class=\"actions\">\n      <el-button @click=\"act('发票')\">申请发票</el-button>\n      <el-button @click=\"act('售后')\">申请售后</el-button>\n      <el-button type=\"primary\" @click=\"act('再次购买')\">再次购买</el-button>\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { ref, computed } from 'vue'\nimport { ElMessage } from 'element-plus'\nconst order = ref({\n  no: 'DD202604180001287',\n  status: '已完成',\n  items: [\n    { id: 1, name: '降噪蓝牙耳机', spec: '经典黑色', qty: 1, price: 399, img: 'https://picsum.photos/seed/o1/120/120' },\n    { id: 2, name: '智能手环', spec: '深空灰 / L 号', qty: 2, price: 249, img: 'https://picsum.photos/seed/o2/120/120' }\n  ],\n  shipping: 10,\n  discount: 50,\n  addr: { name: '王小明', phone: '138****5678', detail: '浙江省杭州市西湖区文三路 500 号某大厦 8 楼' },\n  payment: { method: '微信支付', time: '2026-04-18 14:32:18', tx: '4200002118202604181234567890' }\n})\nconst goodsTotal = computed(() => order.value.items.reduce((s, p) => s + p.price * p.qty, 0))\nconst finalTotal = computed(() => goodsTotal.value + order.value.shipping - order.value.discount)\nfunction act(type) { ElMessage.info(type + ' 功能(略)') }\n</script>\n\n<style scoped>\n.page { padding: 24px; max-width: 960px; margin: 0 auto; }\n.head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }\nh2 { color: #0f172a; margin-bottom: 4px; }\n.no { color: #64748b; font-size: 13px; }\n.panel { margin-bottom: 16px; }\n.panel h3 { color: #0f172a; margin-bottom: 16px; font-size: 1rem; }\n.item { display: grid; grid-template-columns: 80px 1fr auto auto; gap: 16px; align-items: center; padding: 12px 0; border-bottom: 1px solid #f1f5f9; }\n.item img { width: 80px; height: 80px; border-radius: 8px; object-fit: cover; }\n.name { font-weight: 500; color: #0f172a; margin-bottom: 4px; }\n.sku { color: #64748b; font-size: 13px; }\n.qty { color: #64748b; }\n.sub { color: #0f172a; font-weight: 600; min-width: 80px; text-align: right; }\n.total { padding-top: 16px; }\n.row { display: flex; justify-content: space-between; padding: 6px 0; color: #334155; }\n.dis { color: #ef4444; }\n.final { padding-top: 12px; border-top: 1px solid #e2e8f0; margin-top: 8px; font-weight: 600; }\n.pay { color: #ef4444; font-size: 1.25rem; }\n.two { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }\n@media (max-width: 768px) { .two { grid-template-columns: 1fr; } }\n.addr .n { font-weight: 500; color: #0f172a; margin-bottom: 8px; }\n.addr .d { color: #64748b; line-height: 1.6; }\n.pay-info div { display: flex; justify-content: space-between; padding: 8px 0; font-size: 14px; color: #334155; }\n.pay-info span { color: #64748b; }\n.actions { display: flex; gap: 12px; justify-content: flex-end; margin-top: 20px; }\n</style>"
    }
  ],
  "qualityScore": 0.94,
