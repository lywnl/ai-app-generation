  "title": "Vue3 商品卡片列表(图 + 价格 + 加入购物车 + 分类筛选)",
  "embedText": "Vue3 商品列表 商品卡片 电商 购物 加入购物车 价格 图片 分类筛选 标签 popular 热卖 product card 商品展示",
  "description": "电商风格商品展示页,顶部分类 Tab 切换,下方商品卡片网格布局,每张卡片含封面图、名称、价格、描述、加入购物车按钮",
  "files": [
    {
      "path": "src/views/ProductList.vue",
      "content": "<template>\n  <div class=\"page\">\n    <h2 class=\"title\">精选好物</h2>\n    <el-tabs v-model=\"cat\" class=\"tabs\">\n      <el-tab-pane label=\"全部\" name=\"all\" />\n      <el-tab-pane label=\"数码\" name=\"digital\" />\n      <el-tab-pane label=\"家居\" name=\"home\" />\n      <el-tab-pane label=\"美食\" name=\"food\" />\n    </el-tabs>\n    <div class=\"grid\">\n      <div class=\"card\" v-for=\"p in shown\" :key=\"p.id\">\n        <div class=\"cover\">\n          <img :src=\"p.img\" :alt=\"p.name\">\n          <el-tag v-if=\"p.hot\" class=\"tag\" type=\"danger\">热卖</el-tag>\n        </div>\n        <div class=\"info\">\n          <h3>{{ p.name }}</h3>\n          <p class=\"desc\">{{ p.desc }}</p>\n          <div class=\"foot\">\n            <span class=\"price\">¥{{ p.price }}</span>\n            <el-button type=\"primary\" size=\"small\" @click=\"addCart(p)\">加入购物车</el-button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { ref, computed } from 'vue'\nimport { ElMessage } from 'element-plus'\nconst cat = ref('all')\nconst all = ref([\n  { id: 1, name: '降噪蓝牙耳机', desc: '40h 超长续航,主动降噪,Hi-Res 认证', price: 399, cat: 'digital', hot: true, img: 'https://picsum.photos/seed/p1/400/300' },\n  { id: 2, name: '北欧风台灯', desc: '三档色温可调,USB 供电,护眼不刺眼', price: 189, cat: 'home', img: 'https://picsum.photos/seed/p2/400/300' },\n  { id: 3, name: '手冲咖啡豆', desc: '埃塞俄比亚单品,浅烘花果香,250g', price: 98, cat: 'food', hot: true, img: 'https://picsum.photos/seed/p3/400/300' },\n  { id: 4, name: '智能手环', desc: '心率血氧监测,7 天续航,IP68 防水', price: 249, cat: 'digital', img: 'https://picsum.photos/seed/p4/400/300' },\n  { id: 5, name: '羊毛毛毯', desc: '100% 澳洲羊毛,亲肤保暖,冬季必备', price: 299, cat: 'home', img: 'https://picsum.photos/seed/p5/400/300' },\n  { id: 6, name: '精酿啤酒礼盒', desc: '6 种风味精酿,地道德式工艺', price: 158, cat: 'food', img: 'https://picsum.photos/seed/p6/400/300' }\n])\nconst shown = computed(() => cat.value === 'all' ? all.value : all.value.filter(x => x.cat === cat.value))\nfunction addCart(p) { ElMessage.success('已加入购物车:' + p.name) }\n</script>\n\n<style scoped>\n.page { padding: 24px; }\n.title { margin-bottom: 20px; color: #0f172a; }\n.tabs { margin-bottom: 20px; }\n.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px; }\n.card { background: #fff; border-radius: 12px; overflow: hidden; transition: transform .2s, box-shadow .2s; }\n.card:hover { transform: translateY(-4px); box-shadow: 0 12px 28px rgba(0, 0, 0, .08); }\n.cover { position: relative; aspect-ratio: 4/3; overflow: hidden; }\n.cover img { width: 100%; height: 100%; object-fit: cover; }\n.tag { position: absolute; top: 12px; left: 12px; }\n.info { padding: 16px; }\n.info h3 { font-size: 1rem; margin-bottom: 6px; color: #0f172a; }\n.desc { font-size: 13px; color: #64748b; margin-bottom: 12px; line-height: 1.5; min-height: 40px; }\n.foot { display: flex; justify-content: space-between; align-items: center; }\n.price { color: #ef4444; font-size: 1.125rem; font-weight: 700; }\n</style>"
    }
  ],
  "qualityScore": 0.93,
