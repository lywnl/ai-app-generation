  "title": "Vue3 个人资料页(头像 + 基本信息卡 + 统计数据 + 活动时间线)",
  "embedText": "Vue3 个人资料 profile 用户中心 头像 基本信息 统计数据 活动记录 时间线 timeline 成就 徽章 主页 卡片",
  "description": "用户个人主页,顶部大 Banner 含头像/用户名/简介/关注按钮,中间统计数据卡(发布/粉丝/关注),下方活动时间线",
  "files": [
    {
      "path": "src/views/Profile.vue",
      "content": "<template>\n  <div class=\"page\">\n    <div class=\"banner\">\n      <el-avatar :size=\"96\" src=\"https://picsum.photos/seed/avatar/200\" />\n      <div class=\"info\">\n        <h2>{{ user.name }}</h2>\n        <p class=\"bio\">{{ user.bio }}</p>\n        <div class=\"tags\">\n          <el-tag v-for=\"t in user.tags\" :key=\"t\" round>{{ t }}</el-tag>\n        </div>\n      </div>\n      <el-button type=\"primary\">关注</el-button>\n    </div>\n    <div class=\"stats\">\n      <div class=\"stat\" v-for=\"s in stats\" :key=\"s.label\">\n        <div class=\"num\">{{ s.value }}</div>\n        <div class=\"label\">{{ s.label }}</div>\n      </div>\n    </div>\n    <div class=\"section\">\n      <h3>最近活动</h3>\n      <el-timeline>\n        <el-timeline-item v-for=\"a in activities\" :key=\"a.time\" :timestamp=\"a.time\" :color=\"a.color\">\n          {{ a.text }}\n        </el-timeline-item>\n      </el-timeline>\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { ref } from 'vue'\nconst user = ref({ name: '王小明', bio: '全栈工程师 / 开源爱好者 / 咖啡中毒患者', tags: ['Vue', 'Go', 'Rust', 'DevOps'] })\nconst stats = ref([\n  { label: '发布文章', value: 128 },\n  { label: '粉丝', value: '2.3k' },\n  { label: '关注', value: 342 },\n  { label: '获赞', value: '15.7k' }\n])\nconst activities = ref([\n  { time: '2 小时前', text: '发布了一篇新文章《Vue3 组合式 API 实战》', color: '#10b981' },\n  { time: '昨天', text: '在 GitHub 开源了一个新的 UI 组件库', color: '#6366f1' },\n  { time: '3 天前', text: '参加了阿里云开发者大会并发表演讲', color: '#f97316' },\n  { time: '1 周前', text: '加入了\"前端之巅\"技术社区', color: '#94a3b8' }\n])\n</script>\n\n<style scoped>\n.page { padding: 24px; max-width: 960px; margin: 0 auto; }\n.banner { display: flex; gap: 24px; align-items: center; background: #fff; padding: 28px; border-radius: 16px; margin-bottom: 16px; }\n.info { flex: 1; }\n.info h2 { margin-bottom: 6px; color: #0f172a; }\n.bio { color: #64748b; margin-bottom: 12px; }\n.tags { display: flex; gap: 8px; flex-wrap: wrap; }\n.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; margin-bottom: 16px; }\n.stat { background: #fff; padding: 20px; border-radius: 12px; text-align: center; }\n.num { font-size: 1.75rem; font-weight: 700; color: #6366f1; }\n.label { color: #64748b; margin-top: 4px; font-size: 14px; }\n.section { background: #fff; padding: 24px 28px; border-radius: 16px; }\n.section h3 { margin-bottom: 20px; color: #0f172a; }\n</style>"
    }
  ],
