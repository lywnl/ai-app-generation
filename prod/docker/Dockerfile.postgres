# Deprecated:
# This Dockerfile is kept only for fallback/manual build.
# Current deployment uses prebuilt image: pgvector/pgvector:pg16
FROM postgres:latest

ARG PGVECTOR_VERSION=v0.8.0
ARG APT_MIRROR=http://mirrors.aliyun.com/debian/
ARG PGVECTOR_REPO=https://gitee.com/mirrors/pgvector.git

RUN set -eux; \
    . /etc/os-release; \
    printf "deb %s %s main contrib non-free non-free-firmware\n" "${APT_MIRROR}" "${VERSION_CODENAME}" > /etc/apt/sources.list; \
    printf "deb %s %s-updates main contrib non-free non-free-firmware\n" "${APT_MIRROR}" "${VERSION_CODENAME}" >> /etc/apt/sources.list; \
    printf "deb %s %s-backports main contrib non-free non-free-firmware\n" "${APT_MIRROR}" "${VERSION_CODENAME}" >> /etc/apt/sources.list; \
    printf "deb %s-security %s-security main contrib non-free non-free-firmware\n" "${APT_MIRROR}" "${VERSION_CODENAME}" >> /etc/apt/sources.list; \
    apt-get update \
    && apt-get install -y --no-install-recommends \
      build-essential \
      git \
      ca-certificates \
      postgresql-server-dev-${PG_MAJOR} \
    && git clone --branch ${PGVECTOR_VERSION} --depth 1 ${PGVECTOR_REPO} /tmp/pgvector \
    && cd /tmp/pgvector \
    && make \
    && make install \
    && rm -rf /tmp/pgvector \
    && apt-get purge -y --auto-remove build-essential git postgresql-server-dev-${PG_MAJOR} \
    && rm -rf /var/lib/apt/lists/*
