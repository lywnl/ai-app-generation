# ========== Release / Build ==========
# 必填；每次发布使用新的唯一标签，不覆盖上一版镜像。
RELEASE_ID=
# 全新环境留空：完整安装 Java 25、Node 22、Chrome 和 ChromeDriver。
# 已部署服务器保留现有运行时镜像标签，需包含 JDK、Node、浏览器和相关环境变量。
# 不要填本次 RELEASE_ID 对应的输出镜像，避免以自身作为构建基础。
BACKEND_RUNTIME_IMAGE=
# 留空使用 nginx:1.27-alpine；已有环境可以保留现有 Nginx 运行时镜像标签。
NGINX_RUNTIME_IMAGE=

# ========== Ports ==========
BACKEND_HOST_PORT=9025
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000

# ========== Public URL ==========
APP_CODE_DEPLOY_BASE_URL=
VITE_API_BASE_URL=/api

# ========== MySQL / Redis ==========
MYSQL_USER=admin
REDIS_USERNAME=admin
# 中间件统一共享密码：MySQL、Redis、Milvus、MinIO，以及生产环境 Grafana。
# 必填，至少 8 位；仅允许英文字母、数字、下划线（_）、短横线（-）和点（.）。
# 不强制字符组合，建议至少 16 位随机混合；不允许空格、中文及其他特殊字符。
# 示例保持空值，真实密码填写到不提交 Git 的 .env；已有数据卷密码不会自动改变。
INFRA_SHARED_PASSWORD=

# ========== Milvus ==========
RAG_HYBRID_ENABLED=true
# 默认不执行模板回灌；迁移验收阶段临时改为 true，并覆盖三种类型。
RAG_INGEST_ENABLED=false
RAG_INGEST_TYPES=HTML,MULTI_FILE,VUE_PROJECT

# ========== Grafana ==========
GRAFANA_ADMIN_USER=admin

# ========== API Keys ==========
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
COS_HOST=
TEN_SERCET_ID=
TEN_SECRET_KEY=
PEXELS_API_KEY=
