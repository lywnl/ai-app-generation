# ========== Ports ==========
BACKEND_HOST_PORT=9025
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000

# ========== Public URL ==========
APP_CODE_DEPLOY_BASE_URL=
VITE_API_BASE_URL=/api

# ========== MySQL / Redis ==========
MYSQL_USER=admin
REDIS_USERNAME=admin
INFRA_SHARED_PASSWORD=

# ========== Milvus ==========
MILVUS_MINIO_PASSWORD=
RAG_HYBRID_ENABLED=true
# 默认不执行模板回灌；迁移验收阶段临时改为 true，并覆盖三种类型。
RAG_INGEST_ENABLED=false
RAG_INGEST_TYPES=HTML,MULTI_FILE,VUE_PROJECT
# 迁移工具使用的旧 pgvector 容器名，仅供远程迁移阶段填写
SOURCE_PG_CONTAINER=ai-pg
RAG_MIGRATION_BACKUP_DIR=/var/backups/ai-app-generation

# ========== Grafana ==========
GRAFANA_ADMIN_USER=admin

# ========== API Keys ==========
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
COS_HOST=
TEN_SERCET_ID=
TEN_SECRET_KEY=
PEXELS_API_KEY=
