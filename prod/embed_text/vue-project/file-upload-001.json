{
  "id": "vue-file-upload-001",
  "type": "vue-project",
  "category": "tool",
  "style": ["minimal"],
  "tech": ["vue3", "composition-api", "element-plus"],
  "title": "Vue3 文件上传页(拖拽区 + 多文件 + 进度条 + 列表管理)",
  "embedText": "Vue3 文件上传 拖拽上传 多文件 批量上传 进度条 文件列表 上传 删除 el-upload 大文件 图片上传 附件上传",
  "description": "文件上传页,顶部拖拽区支持多选与拖入,下方列表展示已选文件(图标/名称/大小/进度条/状态),支持单个删除和批量上传",
  "files": [{"path": "src/views/FileUpload.vue", "content": "<template>\n  <div class=\"page\">\n    <h2>文件上传</h2>\n    <el-upload class=\"drop\" drag multiple :auto-upload=\"false\" :on-change=\"onChange\" :show-file-list=\"false\">\n      <el-icon class=\"up\"><UploadFilled /></el-icon>\n      <div class=\"txt\">将文件拖到此处,或<em>点击选择</em></div>\n      <div class=\"tip\">支持单次多选 · 单文件不超过 50 MB</div>\n    </el-upload>\n    <div class=\"list\" v-if=\"files.length\">\n      <div class=\"item\" v-for=\"f in files\" :key=\"f.uid\">\n        <div class=\"icon\">{{ iconOf(f.name) }}</div>\n        <div class=\"info\">\n          <div class=\"name\">{{ f.name }}</div>\n          <div class=\"meta\">{{ sizeOf(f.size) }} · {{ statusText(f) }}</div>\n          <el-progress :percentage=\"f.progress\" :status=\"f.progress === 100 ? 'success' : ''\" :stroke-width=\"6\" />\n        </div>\n        <el-button size=\"small\" text type=\"danger\" @click=\"remove(f)\">删除</el-button>\n      </div>\n      <el-button type=\"primary\" class=\"upload-btn\" :loading=\"uploading\" @click=\"submit\">开始上传 ({{ files.length }})</el-button>\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { ref } from 'vue'\nimport { ElMessage } from 'element-plus'\nconst files = ref([])\nconst uploading = ref(false)\nfunction onChange(file) {\n  files.value.push({ uid: file.uid, name: file.name, size: file.size, progress: 0, done: false })\n}\nfunction remove(f) {\n  files.value = files.value.filter(x => x.uid !== f.uid)\n}\nfunction submit() {\n  uploading.value = true\n  files.value.forEach(f => {\n    if (f.done) return\n    const t = setInterval(() => {\n      f.progress = Math.min(100, f.progress + 10 + Math.random() * 15)\n      if (f.progress >= 100) { f.progress = 100; f.done = true; clearInterval(t); checkAll() }\n    }, 250)\n  })\n}\nfunction checkAll() {\n  if (files.value.every(x => x.done)) { uploading.value = false; ElMessage.success('全部上传完成') }\n}\nfunction iconOf(n) { const e = n.split('.').pop().toLowerCase(); return { pdf: '📕', doc: '📘', docx: '📘', xls: '📗', xlsx: '📗', png: '🖼️', jpg: '🖼️', zip: '🗜️' }[e] || '📄' }\nfunction sizeOf(b) { if (b < 1024) return b + ' B'; if (b < 1048576) return (b / 1024).toFixed(1) + ' KB'; return (b / 1048576).toFixed(2) + ' MB' }\nfunction statusText(f) { return f.done ? '已上传' : f.progress > 0 ? '上传中' : '待上传' }\n</script>\n\n<style scoped>\n.page { padding: 24px; max-width: 760px; margin: 0 auto; }\nh2 { color: #0f172a; margin-bottom: 20px; }\n.drop { width: 100%; }\n.up { font-size: 52px; color: #6366f1; }\n.txt { color: #334155; margin-top: 8px; }\n.txt em { color: #6366f1; font-style: normal; }\n.tip { color: #94a3b8; font-size: 13px; margin-top: 4px; }\n.list { margin-top: 24px; }\n.item { display: flex; align-items: center; gap: 16px; padding: 16px; background: #fff; border-radius: 10px; margin-bottom: 10px; border: 1px solid #e2e8f0; }\n.icon { font-size: 32px; width: 48px; text-align: center; }\n.info { flex: 1; }\n.name { font-weight: 500; color: #0f172a; margin-bottom: 4px; }\n.meta { font-size: 13px; color: #64748b; margin-bottom: 6px; }\n.upload-btn { width: 100%; margin-top: 12px; }\n</style>"}],
  "qualityScore": 0.91
}
