  ],
  "title": "Vue3 数据统计仪表盘(统计卡片 + 同比增长 + 进度条 + 迷你柱状图)",
  "embedText": "Vue3 仪表盘 数据面板 dashboard 统计卡片 KPI 同比 环比 增长率 进度条 迷你图 纯 CSS 柱状图 后台首页 数据概览",
  "description": "后台首页典型数据概览,顶部 4 个核心 KPI 卡片(含同比涨跌),下方两个模块:完成率进度条 + 近 7 日纯 CSS 柱状图",
  "files": [
    {
      "path": "src/views/StatsDashboard.vue",
      "content": "<template>\n  <div class=\"page\">\n    <h2>数据概览</h2>\n    <p class=\"sub\">更新时间:{{ now }}</p>\n    <div class=\"kpis\">\n      <div class=\"card\" v-for=\"k in kpis\" :key=\"k.label\">\n        <div class=\"label\">{{ k.label }}</div>\n        <div class=\"value\">{{ k.value }}</div>\n        <div class=\"trend\" :class=\"k.delta >= 0 ? 'up' : 'down'\">{{ k.delta >= 0 ? '↑' : '↓' }} {{ Math.abs(k.delta) }}% 同比</div>\n      </div>\n    </div>\n    <div class=\"row\">\n      <div class=\"panel\">\n        <h3>本月目标完成率</h3>\n        <div class=\"goal\" v-for=\"g in goals\" :key=\"g.label\">\n          <div class=\"g-top\"><span>{{ g.label }}</span><span class=\"g-val\">{{ g.value }} / {{ g.total }}</span></div>\n          <el-progress :percentage=\"Math.round(g.value / g.total * 100)\" :stroke-width=\"12\" :status=\"g.value >= g.total ? 'success' : ''\" />\n        </div>\n      </div>\n      <div class=\"panel\">\n        <h3>近 7 日活跃用户</h3>\n        <div class=\"chart\">\n          <div class=\"bar\" v-for=\"b in bars\" :key=\"b.day\" :style=\"{ height: (b.value / max * 100) + '%' }\">\n            <span class=\"n\">{{ b.value }}</span>\n            <span class=\"d\">{{ b.day }}</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { ref, computed } from 'vue'\nconst now = new Date().toLocaleString('zh-CN')\nconst kpis = ref([\n  { label: '总营收', value: '¥ 1,286,420', delta: 12.5 },\n  { label: '新增用户', value: '8,421', delta: 8.3 },\n  { label: '订单数', value: '2,318', delta: -3.2 },\n  { label: '转化率', value: '4.6%', delta: 1.1 }\n])\nconst goals = ref([\n  { label: '销售额', value: 82, total: 100 },\n  { label: '新客户', value: 47, total: 80 },\n  { label: '复购率', value: 35, total: 40 }\n])\nconst bars = ref([\n  { day: '周一', value: 420 },\n  { day: '周二', value: 580 },\n  { day: '周三', value: 650 },\n  { day: '周四', value: 490 },\n  { day: '周五', value: 720 },\n  { day: '周六', value: 880 },\n  { day: '周日', value: 940 }\n])\nconst max = computed(() => Math.max(...bars.value.map(x => x.value)))\n</script>\n\n<style scoped>\n.page { padding: 24px; }\nh2 { color: #0f172a; }\n.sub { color: #94a3b8; margin: 6px 0 20px; font-size: 14px; }\n.kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 20px; }\n.card { background: #fff; padding: 20px 22px; border-radius: 12px; }\n.label { color: #64748b; font-size: 14px; margin-bottom: 8px; }\n.value { color: #0f172a; font-size: 1.75rem; font-weight: 700; margin-bottom: 6px; }\n.trend { font-size: 13px; }\n.trend.up { color: #16a34a; }\n.trend.down { color: #dc2626; }\n.row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }\n@media (max-width: 768px) { .row { grid-template-columns: 1fr; } }\n.panel { background: #fff; padding: 24px; border-radius: 12px; }\n.panel h3 { color: #0f172a; margin-bottom: 20px; font-size: 1.05rem; }\n.goal { margin-bottom: 18px; }\n.g-top { display: flex; justify-content: space-between; margin-bottom: 6px; color: #334155; font-size: 14px; }\n.g-val { color: #64748b; }\n.chart { display: flex; align-items: flex-end; gap: 8px; height: 200px; padding-top: 24px; }\n.bar { flex: 1; background: linear-gradient(180deg, #6366f1, #818cf8); border-radius: 6px 6px 0 0; position: relative; display: flex; flex-direction: column; align-items: center; min-height: 30px; transition: opacity .2s; }\n.bar:hover { opacity: .8; }\n.bar .n { position: absolute; top: -22px; font-size: 12px; color: #475569; }\n.bar .d { position: absolute; bottom: -22px; font-size: 12px; color: #64748b; }\n</style>"
    }
  ],
  "qualityScore": 0.93,
