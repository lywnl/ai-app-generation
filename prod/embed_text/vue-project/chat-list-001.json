{
  "id": "vue-chat-list-001",
  "type": "vue-project",
  "category": "social",
  "style": ["minimal"],
  "tech": ["vue3", "composition-api", "element-plus"],
  "title": "Vue3 消息聊天列表(左侧联系人 + 右侧气泡对话 + 输入框)",
  "embedText": "Vue3 聊天 消息 IM 即时通讯 聊天窗口 联系人列表 对话气泡 发送消息 输入框 在线状态 未读角标 消息时间 会话",
  "description": "经典 IM 聊天界面:左侧联系人列表(头像/姓名/最后消息/时间/未读数),右侧聊天气泡(左右对齐区分发收),底部输入框",
  "files": [{"path": "src/views/ChatList.vue", "content": "<template>\n  <div class=\"page\">\n    <div class=\"left\">\n      <div class=\"search\"><el-input v-model=\"q\" placeholder=\"搜索联系人\" prefix-icon=\"Search\" /></div>\n      <div class=\"contacts\">\n        <div v-for=\"c in shownContacts\" :key=\"c.id\" class=\"contact\" :class=\"{ active: c.id === cur }\" @click=\"cur = c.id\">\n          <el-badge :is-dot=\"c.online\"><el-avatar :size=\"44\" :src=\"c.avatar\" /></el-badge>\n          <div class=\"meta\">\n            <div class=\"top\"><span class=\"name\">{{ c.name }}</span><span class=\"time\">{{ c.time }}</span></div>\n            <div class=\"bot\"><span class=\"last\">{{ c.last }}</span><el-tag v-if=\"c.unread\" type=\"danger\" size=\"small\" round>{{ c.unread }}</el-tag></div>\n          </div>\n        </div>\n      </div>\n    </div>\n    <div class=\"right\">\n      <div class=\"chat-head\">\n        <el-avatar :size=\"36\" :src=\"curContact.avatar\" />\n        <div>\n          <div class=\"name\">{{ curContact.name }}</div>\n          <div class=\"status\">{{ curContact.online ? '在线' : '离线' }}</div>\n        </div>\n      </div>\n      <div class=\"msgs\" ref=\"msgBox\">\n        <div v-for=\"m in msgs\" :key=\"m.id\" class=\"msg\" :class=\"m.from === 'me' ? 'me' : 'other'\">\n          <el-avatar v-if=\"m.from === 'other'\" :size=\"32\" :src=\"curContact.avatar\" />\n          <div class=\"bubble\">{{ m.text }}</div>\n        </div>\n      </div>\n      <div class=\"input\">\n        <el-input v-model=\"draft\" placeholder=\"输入消息后按回车发送\" @keyup.enter=\"send\" />\n        <el-button type=\"primary\" @click=\"send\">发送</el-button>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { ref, computed, nextTick } from 'vue'\nconst q = ref('')\nconst cur = ref(1)\nconst draft = ref('')\nconst msgBox = ref()\nconst contacts = ref([\n  { id: 1, name: '张伟', avatar: 'https://i.pravatar.cc/80?img=1', last: '好的,那就这么定了', time: '14:32', unread: 0, online: true },\n  { id: 2, name: '李娜', avatar: 'https://i.pravatar.cc/80?img=5', last: '文档已经发给你了,记得看', time: '13:20', unread: 2, online: true },\n  { id: 3, name: '产品群', avatar: 'https://i.pravatar.cc/80?img=10', last: '王强: 明天下午 2 点开会', time: '昨天', unread: 5, online: false },\n  { id: 4, name: '陈明', avatar: 'https://i.pravatar.cc/80?img=11', last: '谢谢你的帮忙', time: '昨天', unread: 0, online: false }\n])\nconst msgMap = ref({\n  1: [{ id: 1, from: 'other', text: '嗨,方案你看了吗?' }, { id: 2, from: 'me', text: '看了,整体没问题,细节我提了几条建议' }, { id: 3, from: 'other', text: '好的,那就这么定了' }],\n  2: [{ id: 1, from: 'other', text: '文档已经发给你了,记得看' }],\n  3: [{ id: 1, from: 'other', text: '王强: 明天下午 2 点开会,别忘了' }],\n  4: [{ id: 1, from: 'me', text: '资料已收到' }, { id: 2, from: 'other', text: '谢谢你的帮忙' }]\n})\nconst shownContacts = computed(() => q.value ? contacts.value.filter(c => c.name.includes(q.value)) : contacts.value)\nconst curContact = computed(() => contacts.value.find(c => c.id === cur.value) || contacts.value[0])\nconst msgs = computed(() => msgMap.value[cur.value] || [])\nasync function send() {\n  if (!draft.value.trim()) return\n  const list = msgMap.value[cur.value]\n  list.push({ id: Date.now(), from: 'me', text: draft.value })\n  draft.value = ''\n  await nextTick()\n  if (msgBox.value) msgBox.value.scrollTop = msgBox.value.scrollHeight\n}\n</script>\n\n<style scoped>\n.page { display: grid; grid-template-columns: 320px 1fr; height: 100vh; background: #f8fafc; }\n@media (max-width: 720px) { .page { grid-template-columns: 1fr; } .left { display: none; } }\n.left { background: #fff; border-right: 1px solid #e2e8f0; display: flex; flex-direction: column; }\n.search { padding: 14px; border-bottom: 1px solid #f1f5f9; }\n.contacts { flex: 1; overflow-y: auto; }\n.contact { display: flex; gap: 12px; padding: 14px 16px; cursor: pointer; border-bottom: 1px solid #f1f5f9; }\n.contact:hover, .contact.active { background: #f1f5f9; }\n.meta { flex: 1; min-width: 0; }\n.top { display: flex; justify-content: space-between; margin-bottom: 4px; }\n.name { font-weight: 500; color: #0f172a; }\n.time { font-size: 12px; color: #94a3b8; }\n.bot { display: flex; justify-content: space-between; align-items: center; }\n.last { color: #64748b; font-size: 13px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 180px; }\n.right { display: flex; flex-direction: column; }\n.chat-head { display: flex; gap: 12px; align-items: center; padding: 14px 20px; background: #fff; border-bottom: 1px solid #e2e8f0; }\n.chat-head .name { font-weight: 500; color: #0f172a; }\n.chat-head .status { font-size: 12px; color: #10b981; }\n.msgs { flex: 1; padding: 20px; overflow-y: auto; display: flex; flex-direction: column; gap: 12px; }\n.msg { display: flex; gap: 10px; align-items: flex-start; max-width: 70%; }\n.msg.me { margin-left: auto; flex-direction: row-reverse; }\n.bubble { padding: 10px 14px; border-radius: 12px; background: #fff; color: #0f172a; line-height: 1.5; }\n.msg.me .bubble { background: #6366f1; color: #fff; }\n.input { display: flex; gap: 8px; padding: 14px; background: #fff; border-top: 1px solid #e2e8f0; }\n</style>"}],
  "qualityScore": 0.92
}
