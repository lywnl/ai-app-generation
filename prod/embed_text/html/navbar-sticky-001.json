    {
      "path": "index.html",
      "content": "<div class=\"navbar-template\">\n  <nav class=\"navbar-template__nav\" aria-label=\"主导航\">\n    <a class=\"navbar-template__logo\" href=\"#top\">✦ Brand</a>\n    <button class=\"navbar-template__burger\" type=\"button\" aria-controls=\"site-menu\" aria-expanded=\"false\" aria-label=\"打开导航菜单\">☰</button>\n    <ul id=\"site-menu\" class=\"navbar-template__menu\">\n      <li><a href=\"#home\">首页</a></li>\n      <li class=\"navbar-template__submenu\"><button type=\"button\" aria-expanded=\"false\">产品 <span aria-hidden=\"true\">▾</span></button><ul><li><a href=\"#features\">功能</a></li><li><a href=\"#pricing\">定价</a></li><li><a href=\"#updates\">更新</a></li></ul></li>\n      <li><a href=\"#docs\">文档</a></li><li><a href=\"#about\">关于</a></li>\n    </ul>\n    <a class=\"navbar-template__cta\" href=\"#start\">开始使用</a>\n  </nav>\n  <section class=\"navbar-template__hero\" id=\"top\"><h2>清晰导航，从任何设备出发</h2><p>向下滚动可查看导航背景变化。</p></section>\n</div>\n<script>\n(() => {\n  const root = document.querySelector('.navbar-template');\n  const nav = root.querySelector('.navbar-template__nav');\n  const burger = root.querySelector('.navbar-template__burger');\n  const menu = root.querySelector('#site-menu');\n  const submenuButton = root.querySelector('.navbar-template__submenu > button');\n  const setMenu = open => {\n    menu.classList.toggle('is-open', open);\n    burger.setAttribute('aria-expanded', String(open));\n    burger.setAttribute('aria-label', open ? '关闭导航菜单' : '打开导航菜单');\n  };\n  burger.addEventListener('click', () => setMenu(burger.getAttribute('aria-expanded') !== 'true'));\n  submenuButton.addEventListener('click', () => {\n    const open = submenuButton.getAttribute('aria-expanded') !== 'true';\n    submenuButton.setAttribute('aria-expanded', String(open));\n  });\n  root.addEventListener('keydown', event => {\n    if (event.key === 'Escape') {\n      const mobileMenuOpen = burger.getAttribute('aria-expanded') === 'true';\n      setMenu(false);\n      submenuButton.setAttribute('aria-expanded', 'false');\n      if (mobileMenuOpen) burger.focus();\n      else submenuButton.focus();\n    }\n  });\n  window.addEventListener('scroll', () => nav.classList.toggle('is-scrolled', window.scrollY > 40), { passive: true });\n})();\n</script>\n<style>\n.navbar-template { box-sizing: border-box; min-height: 560px; color: #0f172a; font-family: system-ui, sans-serif; }\n.navbar-template__nav { position: sticky; top: 0; z-index: 10; display: flex; min-height: 68px; align-items: center; gap: 24px; padding: 12px clamp(16px, 4vw, 48px); background: rgba(255, 255, 255, .82); backdrop-filter: blur(14px); }\n.navbar-template__nav.is-scrolled { box-shadow: 0 8px 28px rgba(15, 23, 42, .1); }\n.navbar-template__logo { color: #0f172a; font-size: 1.1rem; font-weight: 800; text-decoration: none; }\n.navbar-template__menu { display: flex; flex: 1; align-items: center; gap: 22px; margin: 0; padding: 0; list-style: none; }\n.navbar-template__menu a, .navbar-template__submenu > button { min-height: 44px; padding: 11px 4px; border: 0; color: #334155; background: transparent; font: inherit; text-decoration: none; cursor: pointer; }\n.navbar-template__submenu { position: relative; }\n.navbar-template__submenu ul { position: absolute; top: 100%; left: 0; display: none; min-width: 160px; margin: 0; padding: 8px; border: 1px solid #e2e8f0; border-radius: 10px; background: #ffffff; box-shadow: 0 14px 35px rgba(15, 23, 42, .12); list-style: none; }\n.navbar-template__submenu > button[aria-expanded=\"true\"] + ul { display: block; }\n.navbar-template__submenu li a { display: block; padding: 10px; }\n.navbar-template__cta { min-height: 44px; padding: 12px 18px; border-radius: 999px; color: #ffffff; background: #4f46e5; font-weight: 700; text-decoration: none; }\n.navbar-template__burger { display: none; min-width: 44px; min-height: 44px; border: 0; background: transparent; font-size: 1.4rem; cursor: pointer; }\n.navbar-template__hero { display: grid; min-height: 492px; place-content: center; padding: 48px 24px; color: #ffffff; background: linear-gradient(135deg, #4f46e5, #db2777); text-align: center; }\n.navbar-template__hero h2 { margin: 0; font-size: clamp(2rem, 6vw, 4rem); }\n.navbar-template__hero p { color: #fce7f3; }\n.navbar-template a:focus-visible, .navbar-template button:focus-visible { outline: 3px solid #f59e0b; outline-offset: 3px; }\n@media (max-width: 760px) { .navbar-template__burger { display: block; margin-left: auto; } .navbar-template__cta { display: none; } .navbar-template__menu { position: absolute; top: 100%; right: 12px; left: 12px; display: none; flex-direction: column; align-items: stretch; gap: 2px; padding: 12px; border-radius: 12px; background: #ffffff; box-shadow: 0 16px 35px rgba(15, 23, 42, .16); } .navbar-template__menu.is-open { display: flex; } .navbar-template__submenu ul { position: static; box-shadow: none; } }\n</style>\n"
    }
  ],
  "qualityScore": 0.92
