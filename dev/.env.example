# 本地开发环境变量示例
# 使用方式：cp dev/.env.example dev/.env，然后按本机环境填写敏感配置。
# 请勿将真实密码、API Key 或云服务密钥提交到 Git。

# ========== 本地端口（当前启动脚本/Compose 使用的默认值） ==========
BACKEND_HOST_PORT=9025
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
# 当前统一本地 Compose 未启动 Grafana；如启用监控服务可复用此配置。
GRAFANA_ADMIN_USER=admin

# ========== 部署地址与跨域 ==========
# 本地 Nginx 固定监听 80 端口，地址不要追加 /api 等业务路径。
APP_CODE_DEPLOY_BASE_URL=http://localhost
# 前端通过 Nginx 访问后端时使用 /api；直连后端时可填写 http://localhost:9025/api。
VITE_API_BASE_URL=/api
# 同源访问留空；跨域开发时填写逗号分隔的可信 Origin。
APP_CORS_ALLOWED_ORIGINS=

# ========== MySQL / Redis ==========
MYSQL_USER=admin
REDIS_USERNAME=admin
# MySQL root、Redis 和 Milvus root 共用的基础设施密码。
INFRA_SHARED_PASSWORD=

# ========== Milvus / MinIO ==========
# MinIO 密码至少 8 位，不能复用长度不足的共享密码。
MILVUS_MINIO_PASSWORD=
RAG_MILVUS_HOST=localhost
RAG_MILVUS_PORT=19530
RAG_MILVUS_DATABASE=default
RAG_MILVUS_USERNAME=root
# 如需使用独立 Milvus 密码，请取消下一行注释；留空时不要设置该变量，应用会回退使用 INFRA_SHARED_PASSWORD。
# RAG_MILVUS_PASSWORD=

# ========== RAG ==========
RAG_HYBRID_ENABLED=true
RAG_TEMPLATES_DIR=embed_text
# 留空表示不执行模板入库；需要手动入库时填写 HTML、MULTI_FILE 或 VUE_PROJECT。
RAG_INGEST_TYPES=

# ========== 模型日志 ==========
# 仅本地排查问题时临时开启，日志可能包含提示词和生成内容。
AI_MODEL_LOG_REQUESTS=false
AI_MODEL_LOG_RESPONSES=false

# ========== API Key ==========
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
PEXELS_API_KEY=

# ========== 腾讯云 COS ==========
COS_HOST=
TEN_SERCET_ID=
TEN_SECRET_KEY=
