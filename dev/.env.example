# ========== 本地端口（当前启动脚本/Compose 使用的默认值） ==========
# [保留默认] 本地后端端口。当前 start-local.sh 固定使用 9025，仅改此项不会调整启动端口。
BACKEND_HOST_PORT=9025
# [暂不用填写] 当前本地 Compose 不启动 Prometheus。
PROMETHEUS_HOST_PORT=9090
# [暂不用填写] 当前本地 Compose 不启动 Grafana。
GRAFANA_HOST_PORT=3000
# 当前统一本地 Compose 未启动 Grafana；如启用监控服务可复用此配置。
# [暂不用填写] 仅预留给 Grafana。
GRAFANA_ADMIN_USER=admin

# ========== 部署地址与跨域 ==========
# 本地 Nginx 固定监听 80 端口，地址不要追加 /api 等业务路径。
# [保留默认] 本机通过 Nginx 访问已发布网站的地址，默认 http://localhost。
APP_CODE_DEPLOY_BASE_URL=http://localhost
# 前端通过 Nginx 访问后端时使用 /api；直连后端时可填写 http://localhost:9025/api。
# [保留默认] 前端 API 路径；默认通过 Nginx 使用 /api。
VITE_API_BASE_URL=/api
# 同源访问留空；跨域开发时填写逗号分隔的可信 Origin。
# [可留空] 同源开发无需填写；需要跨域时填写完整 Origin，多项用逗号分隔。
APP_CORS_ALLOWED_ORIGINS=

# ========== MySQL / Redis ==========
# [保留默认] Compose 新建的 MySQL 普通用户；当前后端本地默认用 root 连接。
MYSQL_USER=admin
# [保留默认/本地未使用] 当前本地 Redis 与后端使用 default 用户，此项 admin 仅为示例预留。
REDIS_USERNAME=admin
# 中间件统一共享密码：MySQL、Redis、Milvus、MinIO，以及生产环境 Grafana。
# 必填，至少 8 位；仅允许英文字母、数字、下划线（_）、短横线（-）和点（.）。
# 不强制字符组合，建议至少 16 位随机混合；不允许空格、中文及其他特殊字符。
# 示例保持空值，真实密码填写到不提交 Git 的 .env；已有数据卷密码不会自动改变。
INFRA_SHARED_PASSWORD=

# ========== Milvus / MinIO ==========
# [保留默认] Milvus 在本机 Docker 中运行时使用 localhost。
RAG_MILVUS_HOST=localhost
# [保留默认] Milvus gRPC 端口。
RAG_MILVUS_PORT=19530
# [保留默认] Milvus 数据库。
RAG_MILVUS_DATABASE=default
# [保留默认] Milvus 用户名；默认 root。
RAG_MILVUS_USERNAME=root

# ========== RAG ==========
# [保留默认] 启用向量与 BM25 混合检索。
RAG_HYBRID_ENABLED=true
# [保留默认] 项目根目录下的模板目录。
RAG_TEMPLATES_DIR=embed_text
# 留空表示不执行模板入库；需要手动入库时填写 HTML、MULTI_FILE 或 VUE_PROJECT。
# [首次配置先留空] 不自动导入模板；主动导入时还需将 RAG_INGEST_ENABLED 设为 true。
# 导入会调用 DashScope Embedding；类型可用逗号分隔，例如 HTML,MULTI_FILE,VUE_PROJECT。
RAG_INGEST_TYPES=
# [保留默认] 普通启动不执行模板导入。
RAG_INGEST_ENABLED=false

# ========== 模型日志 ==========
# 仅本地排查问题时临时开启，日志可能包含提示词和生成内容。
# [保留默认] false；仅排查问题时临时开启。
AI_MODEL_LOG_REQUESTS=false
# [保留默认] false；仅排查问题时临时开启。
AI_MODEL_LOG_RESPONSES=false

# ========== API Key ==========
# [必填 2/3] 填写 DeepSeek 控制台创建的 API Key，用于生成代码、路由及对话摘要等。
# 获取入口：https://platform.deepseek.com/；当前模型名在 application.yml 中配置为 deepseek-flash。
DEEPSEEK_API_KEY=
# [必填 3/3] 填写阿里云百炼（DashScope）API Key，用于向量化、重排和 AI 生图。
# 获取入口：https://bailian.console.aliyun.com/；Key 需能访问项目配置的模型和中国内地 API 端点。
DASHSCOPE_API_KEY=
# [图片搜索功能必填，暂不用可留空] 填写 Pexels API Key；留空时图片搜索不可用。
# 获取入口：https://www.pexels.com/api/。
PEXELS_API_KEY=

# ========== 腾讯云 COS ==========
# [COS 上传/访问功能必填，暂不用可留空] 填写自己的 COS 桶访问域名，包含 https://，建议不带末尾斜杠。
# 格式示例：https://<桶名-APPID>.cos.<地域>.myqcloud.com；应与下方桶名和地域一致。
COS_HOST=
# [COS 功能必填，暂不用可留空] 填写有目标桶访问权限的腾讯云 SecretId。
# 注意：SERCET 是项目现有拼写，必须保留，不要改成 SECRET。
TEN_SERCET_ID=
# [COS 功能必填，暂不用可留空] 填写与上面 SecretId 配套的 SecretKey。
# 获取入口：https://console.cloud.tencent.com/cam/capi。
TEN_SECRET_KEY=

# [COS 配套配置] 下列环境变量通过 Spring Boot 覆盖 application.yml 中原有的地域和桶名。
# [使用自己的 COS 时确认] 必须与实际存储桶地域一致，例如 ap-beijing 或 ap-shanghai。
COS_CLIENT_REGION=ap-beijing
# [COS 功能必填，暂不用可留空] 填写完整桶名，包含 -APPID 后缀；不要填写 URL。
COS_CLIENT_BUCKET=
